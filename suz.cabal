cabal-version:      2.4
name:               suz
version:            0.1.0.0
synopsis:           Morpheme-level interlinear glossing engine
license:            GPL-3.0-or-later
license-file:       LICENSE
build-type:         Simple
extra-doc-files:    README.md
data-files:         languages/*.language
extra-source-files: Makefile
                    include/suz.h
                    include/suz/*.h
                    scripts/bundle.sh
                    c-example/Makefile
                    c-example/*.c
                    c-example/*.h
                    gtk/Makefile
                    gtk/*.c
                    gtk/*.h
                    gtk/samples/*.txt
                    gtk/samples/*.suz
                    data/dev.anmitali.Suz.desktop
                    data/dev.anmitali.Suz.metainfo.xml
                    data/icons/hicolor/scalable/apps/*.svg
                    data/icons/hicolor/symbolic/apps/*.svg

common shared
    default-language:   Haskell2010
    default-extensions: OverloadedStrings
    ghc-options:        -Wall
    build-depends:      base >=4.14 && <5,
                        text >=1.2 && <3

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Suz
                      Suz.Build
                      Suz.Codec
                      Suz.Codec.Escape
                      Suz.Codec.Parser
                      Suz.Codec.Ud
                      Suz.Command
                      Suz.Command.Edit
                      Suz.Command.Types
                      Suz.Conllu
                      Suz.Html
                      Suz.Import
                      Suz.Journal
                      Suz.Json
                      Suz.Latex
                      Suz.Language
                      Suz.LanguageBinary
                      Suz.LanguageText
                      Suz.Learn
                      Suz.Leipzig
                      Suz.Model
                      Suz.Render
                      Suz.Segment
                      Suz.Snapshot
                      Suz.Suggest
                      Suz.Toolbox
                      Suz.Validate
    other-modules:    Suz.Interlinear
    build-depends:    bytestring >=0.10 && <0.13,
                      containers >=0.6 && <0.8

test-suite suz-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    Fixtures
                      Test.Codec
                      Test.Command
                      Test.Conllu
                      Test.Edit
                      Test.Escape
                      Test.Import
                      Test.Journal
                      Test.Json
                      Test.Language
                      Test.LanguageBinary
                      Test.LanguageText
                      Test.Languages
                      Test.Latex
                      Test.Learn
                      Test.Leipzig
                      Test.Model
                      Test.Parser
                      Test.Property
                      Test.Render
                      Test.Segment
                      Test.Snapshot
                      Test.Suggest
                      Test.Toolbox
                      Test.Validate
    build-depends:    suz,
                      bytestring >=0.10 && <0.13,
                      QuickCheck >=2.14 && <3

executable suz-examples
    import:           shared
    hs-source-dirs:   examples
    main-is:          Main.hs
    other-modules:    Paths_suz
    autogen-modules:  Paths_suz
    build-depends:    suz,
                      bytestring >=0.10 && <0.13

foreign-library suz
    import:           shared
    type:             native-shared
    lib-version-info: 0:0:0
    hs-source-dirs:   ffi
    other-modules:    Suz.Foreign
                      Suz.Foreign.Document
                      Suz.Foreign.Handle
                      Suz.Foreign.Language
                      Suz.Foreign.Learning
                      Suz.Foreign.Session
    c-sources:        csrc/suz_init.c
    ld-options:       -Wl,-rpath,$ORIGIN
    include-dirs:     include
    build-depends:    suz,
                      bytestring >=0.10 && <0.13
