cabal-version:      2.4
name:               suz
version:            0.1.0.0
synopsis:           Morpheme-level interlinear glossing engine
license:            GPL-3.0-or-later
license-file:       LICENSE
build-type:         Simple
extra-doc-files:    README.md

common shared
    default-language:   Haskell2010
    default-extensions: OverloadedStrings
    ghc-options:        -Wall
    build-depends:      base >=4.14 && <5,
                        text >=1.2 && <3

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Suz
                      Suz.Build
                      Suz.Codec
                      Suz.Command
                      Suz.Journal
                      Suz.Language
                      Suz.LanguageBinary
                      Suz.LanguageText
                      Suz.Model
                      Suz.Render
                      Suz.Suggest
    build-depends:    bytestring >=0.10 && <0.13,
                      containers >=0.6 && <0.8

test-suite suz-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:    suz,
                      bytestring >=0.10 && <0.13

executable suz-examples
    import:           shared
    hs-source-dirs:   examples
    main-is:          Main.hs
    other-modules:    English
                      Tatar
    build-depends:    suz
