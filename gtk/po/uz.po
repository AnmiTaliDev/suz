msgstr "glossa;glosslash;qatorlararo;morfema;tilshunoslik;"

#: ../data/dev.anmitali.Suz.metainfo.xml:10
msgid ""
"Suz splits the words of a text into morphs and glosses them, using weight "
"tables that learn from your corrections. It reads plain text and exports "
"interlinear text, Toolbox, CoNLL-U, JSON, LaTeX, HTML, ELAN and FLExText."
msgstr ""
"Suz matndagi so‘zlarni morflarga bo‘ladi va tuzatishlaringizdan o‘rganadigan "
"vazn jadvallari yordamida glosslaydi. U oddiy matnni o‘qiydi va qatorlararo "
"matn, Toolbox, CoNLL-U, JSON, LaTeX, HTML, ELAN hamda FLExText formatlariga "
"eksport qiladi."
