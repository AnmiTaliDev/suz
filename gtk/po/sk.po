msgstr "glosa;glosovanie;medziriadkový;morféma;jazykoveda;"

#: ../data/dev.anmitali.Suz.metainfo.xml:10
msgid ""
"Suz splits the words of a text into morphs and glosses them, using weight "
"tables that learn from your corrections. It reads plain text and exports "
"interlinear text, Toolbox, CoNLL-U, JSON, LaTeX, HTML, ELAN and FLExText."
msgstr ""
"Suz rozdeľuje slová textu na morfy a glosuje ich pomocou tabuliek váh, ktoré "
"sa učia z vašich opráv. Číta obyčajný text a exportuje medziriadkový text, "
"Toolbox, CoNLL-U, JSON, LaTeX, HTML, ELAN a FLExText."
