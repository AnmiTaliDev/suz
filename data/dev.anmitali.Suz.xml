<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-suz-document">
    <comment>Suz document</comment>
    <sub-class-of type="text/plain"/>
    <magic priority="60">
      <match type="string" value="suz-snapshot&#9;" offset="0"/>
    </magic>
    <glob pattern="*.suz"/>
  </mime-type>
  <mime-type type="application/x-eaf+xml">
    <comment>ELAN annotation file</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.eaf"/>
  </mime-type>
  <mime-type type="application/x-flextext+xml">
    <comment>FLExText interlinear text</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.flextext"/>
  </mime-type>
  <mime-type type="text/x-conllu">
    <comment>CoNLL-U treebank</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.conllu"/>
  </mime-type>
</mime-info>
