<component type="desktop-application">
  <id>dev.anmitali.Suz</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Suz</name>
  <summary>Morpheme-level interlinear glossing</summary>
  <description>
    <p>Suz splits the words of a text into morphs and glosses them, using weight tables that learn from your corrections. It reads plain text and exports interlinear text, Toolbox, CoNLL-U, JSON and LaTeX.</p>
  </description>
  <launchable type="desktop-id">dev.anmitali.Suz.desktop</launchable>
  <provides>
    <binary>suz-gtk</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release version="0.1.0" date="2026-10-31"/>
  </releases>
</component>
